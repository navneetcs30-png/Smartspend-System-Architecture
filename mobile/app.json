{
  "expo": {
    "name": "SmartSpend AI",
    "slug": "smartspend-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A11",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#070A11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartspend.ai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070A11"
      },
      "package": "com.smartspend.ai"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
